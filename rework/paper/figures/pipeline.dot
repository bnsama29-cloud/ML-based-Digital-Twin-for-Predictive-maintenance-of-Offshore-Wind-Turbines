digraph G {
  graph [rankdir=TB, splines=ortho, nodesep=0.16, ranksep=0.28, pad=0.05, fontname="Helvetica", newrank=true];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, margin="0.11,0.07", width=1.25,
         penwidth=1.1, color="#2a78d6", fillcolor="#eaf2fc", fontcolor="#0b1b3a", height=0.62];
  edge  [color="#0b1b3a", penwidth=1.0, arrowsize=0.6];

  S [group=g1, label=<<B>SCADA data</B><BR/><FONT POINT-SIZE="8">10-min, 3 farms,<BR/>95 datasets</FONT>>];
  P [group=g2, label=<<B>Leakage-safe<BR/>preprocessing</B><BR/><FONT POINT-SIZE="8">time-ordered split<BR/>normal-status rows<BR/>idle-in-wind filter</FONT>>];
  D [group=g3, label=<<B>Detector</B><BR/><FONT POINT-SIZE="8">Dense AE · Cond. AE<BR/>LSTM AE · PCA<BR/>Isol. Forest · 3σ</FONT>>];
  E [group=g4, label=<<B>Reconstruction<BR/>error e(t)</B>>];
  N [group=g5, label=<<B>Condition<BR/>normalisation</B><BR/><FONT POINT-SIZE="8">r(t) = log e(t) − g(u(t))</FONT>>];
  M [group=g6, label=<<B>Causal 6 h<BR/>median</B>>];
  T [group=g7, label=<<B>Threshold τ +<BR/>12 h counter</B>>];
  A [group=g8, label=<<B>ALARM</B>>, fillcolor="#fde3d6", color="#eb6834"];

  node [color="#6b6a66", fillcolor="#f2f2f0", height=0.42];
  Ca [group=g5, label=<C<SUB>a</SUB> → fits g>];
  Cb [group=g7, label=<C<SUB>b</SUB> → sets τ>];

  Attr [group=g3, label=<Plant-area attribution<BR/><FONT POINT-SIZE="8">channel error ratio, 10 areas</FONT>>, height=0.5];
  HI   [group=g6, label=<Health index +<BR/>time to threshold<BR/><FONT POINT-SIZE="8">95% band</FONT>>, height=0.5];
  Gate [group=g7, label=<Work-order gate<BR/><FONT POINT-SIZE="8">G = 72 / 168 / 336 h</FONT>>, height=0.5];
  U    [group=g8, label=<Unity playback<BR/><FONT POINT-SIZE="8">measured values</FONT>>, height=0.5];

  {rank=same; S; P; D; E; N; M; T; A;}
  J [shape=point, width=0.03, height=0.03, group=g8, color="#0b1b3a", style=filled, fillcolor="#0b1b3a"];
  {rank=same; Ca; Cb; J;}
  {rank=same; Attr; HI; Gate; U;}

  S -> P -> D -> E -> N -> M -> T -> A;
  N -> Ca [dir=back];
  T -> Cb [dir=back];
  Ca -> Attr [style=invis]; Cb -> Gate [style=invis];
  D -> Attr;
  M -> HI;
  HI -> Gate;
  A -> J [arrowhead=none];
  J -> U;
  J -> Gate;
}
